# ==============================================================================
# OmniOperand Micro-Payment & Remote MCP Configuration
# ==============================================================================

# Merchant recipient EVM wallet address for Base micropayments (x402 protocol)
# Example: Base / EVM Address
MERCHANT_WALLET_ADDRESS=0x2b8E141680d2A77dC6f5F31346387Fe559eb5681

# Base JSON-RPC URL for on-chain verification & state settlement
RPC_URL=https://mainnet.base.org

# Remote MCP Server & Gateway HTTP Port
PORT=3001

# Bearer token for SSE remote MCP client authentication
MCP_BEARER_TOKEN=omni_mcp_secret_bearer_token

# Mock on-chain settlements in test environments (prevents network timeouts)
MOCK_SETTLEMENT=false
