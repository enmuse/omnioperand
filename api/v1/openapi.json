{
  "openapi": "3.1.0",
  "info": {
    "title": "OmniOperand High-Precision Mathematical REST API",
    "version": "1.1.0",
    "description": "Deterministic computational REST API engineered for autonomous AI agents, LLMs, researchers, and engineers. Resolves multi-parameter geometric and financial systems with machine precision, radical closed forms, and zero arithmetic hallucination.",
    "contact": {
      "name": "OmniOperand Computational Systems",
      "url": "https://omnioperand.com",
      "email": "api@omnioperand.com"
    },
    "license": {
      "name": "Creative Commons Attribution 4.0 International (CC BY 4.0)",
      "url": "https://creativecommons.org/licenses/by/4.0/"
    }
  },
  "servers": [
    {
      "url": "https://omnioperand.com/api/v1",
      "description": "Cloudflare Global Edge Production Server (<15ms latency)"
    }
  ],
  "security": [
    { "bearerAuth": [] },
    { "apiKeyAuth": [] }
  ],
  "paths": {
    "/auth/keys": {
      "post": {
        "summary": "Create API key",
        "description": "Generates a cryptographically secure API key with tier quotas (Free, Pro, Enterprise).",
        "operationId": "createApiKey",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tier": { "type": "string", "enum": ["free", "pro", "enterprise"], "default": "free" },
                  "name": { "type": "string", "default": "My API Key" },
                  "email": { "type": "string", "format": "email" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "API Key created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StandardEnvelope" }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Inspect tier quotas and available demo keys",
        "operationId": "getTierInfo",
        "security": [],
        "responses": {
          "200": {
            "description": "Tier quotas information",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StandardEnvelope" }
              }
            }
          }
        }
      }
    },
    "/usage": {
      "get": {
        "summary": "Get consumer usage telemetry and billing ledger",
        "description": "Returns current month request volume, average latency, and endpoint breakdown.",
        "operationId": "getUsage",
        "responses": {
          "200": {
            "description": "Consumer usage statistics",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StandardEnvelope" }
              }
            }
          }
        }
      }
    },
    "/prompts": {
      "get": {
        "summary": "AI Prompt Library",
        "description": "Returns optimized system prompts and zero-shot tool invocation prompts for LLMs.",
        "operationId": "getPrompts",
        "security": [],
        "responses": {
          "200": {
            "description": "AI prompt library payload",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StandardEnvelope" }
              }
            }
          }
        }
      }
    },
    "/leads": {
      "post": {
        "summary": "Ingest embed widget lead capture",
        "description": "Webhook endpoint for embeddable calculator widgets to store leads.",
        "operationId": "captureLead",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "calculator"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "calculator": { "type": "string" },
                  "partner_id": { "type": "string", "default": "direct" },
                  "inputs": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Lead recorded successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StandardEnvelope" }
              }
            }
          }
        }
      }
    },
    "/finance/mortgage": {
      "get": {
        "summary": "Solve fixed-rate mortgage amortization",
        "description": "Computes base monthly payment, total interest, and early payoff acceleration with extra monthly payments.",
        "operationId": "solveMortgage",
        "parameters": [
          { "name": "principal", "in": "query", "schema": { "type": "number", "default": 400000 } },
          { "name": "annual_rate", "in": "query", "schema": { "type": "number", "default": 6.5 } },
          { "name": "term_years", "in": "query", "schema": { "type": "number", "default": 30 } },
          { "name": "extra_monthly", "in": "query", "schema": { "type": "number", "default": 0 } }
        ],
        "responses": {
          "200": {
            "description": "Mortgage calculation results",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StandardEnvelope" }
              }
            }
          }
        }
      }
    },
    "/finance/compound-interest": {
      "get": {
        "summary": "Solve compound interest & APY growth",
        "operationId": "solveCompoundInterest",
        "parameters": [
          { "name": "principal", "in": "query", "schema": { "type": "number", "default": 10000 } },
          { "name": "annual_rate", "in": "query", "schema": { "type": "number", "default": 7.0 } },
          { "name": "years", "in": "query", "schema": { "type": "number", "default": 10 } },
          { "name": "compound_frequency", "in": "query", "schema": { "type": "integer", "default": 12 } },
          { "name": "monthly_contribution", "in": "query", "schema": { "type": "number", "default": 500 } }
        ],
        "responses": {
          "200": {
            "description": "Compound interest results",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StandardEnvelope" }
              }
            }
          }
        }
      }
    },
    "/geometry/2d/shapes/octagon": {
      "get": {
        "summary": "Solve regular octagon (8 variables)",
        "operationId": "solveOctagon",
        "parameters": [
          {
            "name": "driver",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["side", "area", "perimeter", "apothem", "circumradius", "span", "short_diagonal", "long_diagonal"],
              "default": "side"
            }
          },
          { "name": "value", "in": "query", "schema": { "type": "number", "default": 10.0 } },
          { "name": "precision", "in": "query", "schema": { "type": "integer", "default": 6 } }
        ],
        "responses": {
          "200": {
            "description": "Octagon calculation results",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StandardEnvelope" }
              }
            }
          }
        }
      }
    },
    "/geometry/2d/shapes/regular-polygon": {
      "get": {
        "summary": "Solve arbitrary regular polygon (n=3 to 1000)",
        "operationId": "solveRegularPolygon",
        "parameters": [
          { "name": "n", "in": "query", "schema": { "type": "integer", "default": 8 } },
          { "name": "driver", "in": "query", "schema": { "type": "string", "default": "side" } },
          { "name": "value", "in": "query", "schema": { "type": "number", "default": 10.0 } },
          { "name": "precision", "in": "query", "schema": { "type": "integer", "default": 6 } }
        ],
        "responses": {
          "200": {
            "description": "Polygon calculation results",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StandardEnvelope" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Standard Authorization Bearer token header"
      },
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "API Key header authentication"
      }
    },
    "schemas": {
      "StandardEnvelope": {
        "type": "object",
        "required": ["success", "calculator", "inputs", "result", "execution_time_ms", "units"],
        "properties": {
          "success": { "type": "boolean", "example": true },
          "calculator": { "type": "string", "example": "mortgage" },
          "inputs": { "type": "object" },
          "result": { "type": "object" },
          "execution_time_ms": { "type": "number", "example": 0.45 },
          "units": { "type": "object" },
          "meta": { "type": "object" }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["success", "error", "execution_time_ms"],
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "example": "RATE_LIMIT_EXCEEDED" },
              "message": { "type": "string" },
              "details": { "type": "object" }
            }
          },
          "execution_time_ms": { "type": "number", "example": 0.12 }
        }
      }
    }
  }
}
